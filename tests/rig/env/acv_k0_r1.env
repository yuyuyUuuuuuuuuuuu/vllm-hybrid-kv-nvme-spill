APCREREAD_STRICT=1
NVMESPILL_ASYNC=1
NVMESPILL_FAULT=crc
# the async latency model (0-80 / 0-250 ms per 4 KiB rig block) is 10-25x slower per block than real NVMe on
# production blocks: deadlines scaled to match (production defaults 120 s save / 30 s load)
GLM53_NVME_SPILL_SAVE_DEADLINE_S=900
GLM53_NVME_SPILL_LOAD_DEADLINE_S=600
GLM53_NVME_SPILL_KEEP_PER_CHAIN=0
APCREREAD_VIOL_DUMP=/w/rig-out/acv_k0_r1_s2.viol.json
APCREREAD_ADM_DUMP=/w/rig-out/acv_k0_r1_s2.adm.json
